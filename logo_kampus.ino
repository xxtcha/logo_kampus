void setup(){
  Serial.begin(115200);
  if(!OLED.begin(SSD1306_SWITCHCAPVCC, 0x3C))
  {
  Serial.print(F("Gagal Menghubungkan OLED"));
  while(1);
  }
  delay(2000);

  OLED.clearDisplay();
  OLED.setTextSize(1);
  OLED.setTextColor(WHITE);
}
void loop(){
  OLED.clearDisplay();
  OLED.setCursor(0,0);
  OLED.drawBitmap(0, 0, epd_bitmap_umi_color, 128, 64, WHITE);
  OLED.display();
  delay(500);
}